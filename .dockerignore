# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.
# Lands at the fork root (the build context) when the template is copied in.

# ── Build outputs / local cruft ──────────────────────────────────────────────
# Keep build artifacts out of the context — the COPY boundary separates source
# from artifacts. build.sh produces its outputs under /mayhem at build time, and
# rtpproxy's autotools build litters .o/.lo/.la/.libs/.deps in-tree.
*.o
*.lo
*.la
*.a
*.so
.libs/
.deps/
.dirstamp
config.log
config.status
**/Makefile
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
